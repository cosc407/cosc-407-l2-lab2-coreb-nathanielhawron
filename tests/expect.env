# What core B's given barrier and alternative are supposed to do.
# Read by tests/run_tests.sh, which is identical in all four cores.

VARIATION=B

ALT_LABEL="the two-turnstile barrier, built on a counting semaphore"
ALT_CORRECT=yes

# See core A's expect.env for the list of checks.
#
# Core B's given barrier deadlocks above two threads, so there is nothing to
# time against it. The auto-checked claim is the trap itself: correct at two
# threads, stopped at four, identically on every machine. fixed against alt on
# CPU time is the interesting comparison and it is marked from RESULTS.md,
# because the margin depends on how the platform implements a wake-up.
CORE_CHECK=given_correct_at_two_deadlocks_at_four

# Deadlocks are expected here, and every one of them costs the watchdog's worth
# of wall-clock time. Five seconds x a handful of runs is the price of this
# core's checks.
WATCHDOG=5
